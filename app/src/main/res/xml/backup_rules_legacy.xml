<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (API 26-30), referenced by android:fullBackupContent.

  Before Android 12 the only Auto Backup destination is Google Drive and there
  is no device-transfer variant, so everything is excluded. Users on API 26-30
  get no automatic backup; the ZIP export/import planned for stage 6 covers
  them.

  VERIFY: same path="." caveat as backup_rules.xml.
  https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
